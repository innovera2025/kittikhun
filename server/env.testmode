# ═══════════════════════════════════════════════════════════════════════════
# 🚨 สวิตช์ทดสอบชั่วคราว — ยอมให้ "บัญชีเขียน" มีสิทธิ์กว้างเกินขอบเขตที่ตกลงไว้
#
# มีไว้เพื่อทดสอบสายจริง (สแกน → เทียบยอด ERP → กรอก → ส่งกลับ ERP) ก่อนที่
# ฝ่าย ERP จะสร้างบัญชี tcl_writer ให้ — ระหว่างนี้ใช้บัญชีที่เขียน ERP ได้อยู่แล้ว
#
# ไฟล์นี้ **ไม่เปิดเส้นทางเขียนเอง** และไม่มี secret ใด ๆ
# ตัวเปิดจริงคือ ERP_WRITEBACK_ENABLED + บัญชีเขียน ซึ่งต้องใส่ในไฟล์ตั้งค่าหลัก
# ของแต่ละเครื่อง (ที่เดียวที่เก็บรหัสผ่าน)
#
# ผลของสวิตช์นี้เมื่อเปิดเส้นทางเขียนแล้ว:
#   - ข้อหา "บัญชีเขียนมีสิทธิ์กว้างเกินขอบเขต" (sysadmin/db_owner/db_datawriter)
#     เปลี่ยนจากหยุด boot เป็นคำเตือนใน log
#   - ข้อหา "บัญชีเขียนซ้ำกับบัญชีอ่าน" และ "ห้ามใช้ sa" ถูกยกเว้น
#   - ถ้าบัญชีอ่านเผลอเป็นบัญชีที่เขียนได้ ก็เตือนแทนหยุด boot
#
# ยังหยุด boot เหมือนเดิมทุกกรณี (ไม่ผ่อนให้):
#   - บัญชีเขียนมีสิทธิ์ไม่พอจริง (ERP_WRITE_SCOPE_INSUFFICIENT)
#   - probe สรุปสิทธิ์ไม่ได้ (ERP_WRITE_PROBE_INCONCLUSIVE)
#   - ภาษาไทยจาก ERP เพี้ยน (ERP_THAI_DECODE)
#
# ⛔ ลบไฟล์นี้ทิ้ง + ลบบล็อก env_file ใน docker-compose.yml เมื่อได้ tcl_writer แล้ว
# ═══════════════════════════════════════════════════════════════════════════

ERP_UNSAFE_ALLOW_PRIVILEGED_ACCOUNT=true
