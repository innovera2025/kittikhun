{
  "name": "kittikhun-stock-api",
  "version": "4.0.0",
  "description": "KITTIKHUN Mobile Stock Check — backend API (NestJS 11 + Fastify, ERP read-only)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migrate": "npm run db:schema",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns '/test/(auth-integration|count-cycle)\\.spec\\.ts$'",
    "test:integration": "jest test/auth-integration.spec.ts test/count-cycle.spec.ts",
    "verify:erp": "ts-node scripts/verify-erp.ts",
    "create-admin": "ts-node src/cli/create-admin.ts",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "argon2": "^0.43.0",
    "mssql": "^11.0.1",
    "nestjs-zod": "^4.3.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.15.32",
    "@types/pg": "^8.21.0",
    "eslint": "^9.33.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "maxWorkers": 1
  }
}
